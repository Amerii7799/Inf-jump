-- Infinite Jump + Toggle (single Script)
-- Option A (best): StarterPlayer > StarterPlayerScripts, RunContext = Client -> دکمه روی صفحه
-- Option B (fallback): ServerScriptService -> یه Tool تو بک‌پک میاد، کلیک کنی toggle میشه

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local COOLDOWN = 0.1 -- seconds between air jumps
local ON_COLOR = Color3.fromRGB(46, 160, 67)
local OFF_COLOR = Color3.fromRGB(170, 50, 50)

local function doJump(hum, last)
	if hum.Health > 0 and os.clock() - last >= COOLDOWN then
		hum:ChangeState(Enum.HumanoidStateType.Jumping)
		return os.clock()
	end
	return last
end

if RunService:IsClient() then
	-- client mode: screen button + JumpRequest
	local player = Players.LocalPlayer
	local enabled = false
	local last = 0

	local gui = Instance.new("ScreenGui")
	gui.Name = "InfJumpGui"
	gui.ResetOnSpawn = false
	gui.Parent = player:WaitForChild("PlayerGui")

	local btn = Instance.new("TextButton")
	btn.Size = UDim2.fromOffset(130, 44)
	btn.Position = UDim2.new(0, 12, 0.5, -22)
	btn.BackgroundColor3 = OFF_COLOR
	btn.TextColor3 = Color3.new(1, 1, 1)
	btn.Font = Enum.Font.GothamBold
	btn.TextSize = 16
	btn.Text = "Inf Jump: OFF"
	btn.Parent = gui
	Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 8)

	btn.Activated:Connect(function()
		enabled = not enabled
		btn.Text = "Inf Jump: " .. (enabled and "ON" or "OFF")
		btn.BackgroundColor3 = enabled and ON_COLOR or OFF_COLOR
	end)

	UserInputService.JumpRequest:Connect(function()
		if not enabled then return end
		local char = player.Character
		local hum = char and char:FindFirstChildOfClass("Humanoid")
		if hum then
			last = doJump(hum, last)
		end
	end)
else
	-- server mode: GUI clicks don't replicate to server, so a Tool is the toggle (Tool.Activated does)
	local enabled = {} -- [player] = bool

	local function giveTool(player)
		local backpack = player:WaitForChild("Backpack")
		if backpack:FindFirstChild("InfJumpTool") then return end

		local tool = Instance.new("Tool")
		tool.Name = "InfJumpTool"
		tool.RequiresHandle = false
		tool.CanBeDropped = false
		tool.ToolTip = "Toggle Infinite Jump"

		local function refresh()
			tool.Name = enabled[player] and "InfJump: ON" or "InfJump: OFF"
		end
		refresh()

		tool.Activated:Connect(function()
			enabled[player] = not enabled[player]
			refresh()
		end)

		tool.Parent = backpack
	end

	local function setup(player)
		enabled[player] = false

		local function onChar(char)
			giveTool(player)
			local hum = char:WaitForChild("Humanoid", 10)
			if not hum then return end
			local last = 0
			hum:GetPropertyChangedSignal("Jump"):Connect(function()
				if hum.Jump and enabled[player] then
					last = doJump(hum, last)
				end
			end)
		end

		if player.Character then task.spawn(onChar, player.Character) end
		player.CharacterAdded:Connect(onChar)
	end

	for _, p in ipairs(Players:GetPlayers()) do setup(p) end
	Players.PlayerAdded:Connect(setup)
	Players.PlayerRemoving:Connect(function(p) enabled[p] = nil end)
end
